---
import Base from '../../layouts/Base.astro';
import { getGraph } from '../../lib/graph';
import { href, t, type Lang } from '../../lib/i18n';
import { forceLayout } from '../../lib/layout';

// The home page is only the title screen: the whole graph drawn as a sky (scripts/splash.ts). The guided overview
// that used to live here is on /overview/.
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const g = await getGraph();
const { nodes } = forceLayout(g);

const stats = [
  { n: g.topics.length, key: 'home.stats.topics' as const },
  { n: g.edges.length, key: 'home.stats.links' as const },
  { n: g.areas.length, key: 'home.stats.areas' as const },
];

// ---- payload for the client: positions from the same layout as the map ---------------------------------------------
const areaIndex = new Map(g.areas.map((a, i) => [a.id, i]));
const centroid = g.areas.map((a) => {
  const own = nodes.filter((n) => n.area === a.id);
  const x = own.reduce((s, n) => s + n.x, 0) / Math.max(1, own.length);
  const y = Math.min(...own.map((n) => n.y));
  return { t: a.title[lang], k: a.kind === 'math' ? 0 : 1, x: Math.round(x), y: Math.round(y) };
});
const index = new Map(g.topics.map((tp, i) => [tp.id, i]));
const data = {
  // [x, y, radius, kind (0 math, 1 computing), core, area]
  nodes: g.topics.map((tp, i) => [
    Math.round(nodes[i]!.x),
    Math.round(nodes[i]!.y),
    Math.round(nodes[i]!.r * 10) / 10,
    g.areas[areaIndex.get(tp.area)!]!.kind === 'math' ? 0 : 1,
    tp.core ? 1 : 0,
    areaIndex.get(tp.area),
  ]),
  ids: g.topics.map((tp) => tp.id),
  titles: g.topics.map((tp) => tp.title[lang]),
  // [from, to, application (math → computing)]
  edges: g.edges.map((e) => [index.get(e.from), index.get(e.to), e.kind === 'application' ? 1 : 0]),
  areas: centroid,
  // The chain shown first: the curated path from functions to backpropagation (as on the overview page).
  featured: ['functions', 'derivative', 'chain-rule', 'multivariable-functions', 'partial-derivatives', 'gradient',
    'multivariable-chain-rule', 'loss-function', 'gradient-descent', 'neural-networks', 'backpropagation']
    .map((id) => index.get(id))
    .filter((i) => i !== undefined),
  topicUrl: href(lang, 'topic/'),
};
---

<Base lang={lang} bodyClass="home-splash">
  <section class="splash" aria-labelledby="splash-title">
    <canvas class="splash-canvas" role="img" aria-label={t(lang, 'splash.label')}></canvas>
    <div class="splash-copy">
      <p class="eyebrow">{t(lang, 'splash.eyebrow')}</p>
      <h1 id="splash-title">Calculus <span class="x">×</span> Computing</h1>
      <p class="lead">{t(lang, 'splash.lead')}</p>
      <div class="hero-cta">
        <a class="btn primary" href={href(lang, 'overview/')}>{t(lang, 'splash.start')} →</a>
        <a class="btn" href={href(lang, 'map/')}>⌖ {t(lang, 'home.explore')}</a>
        <a class="btn" href={href(lang, 'topics/')}>{t(lang, 'home.syllabus')}</a>
      </div>
      <dl class="stats">
        {
          stats.map((s) => (
            <div>
              <dt>{t(lang, s.key)}</dt>
              <dd>{s.n}</dd>
            </div>
          ))
        }
      </dl>
      <p class="splash-hint">{t(lang, 'splash.hint')}</p>
    </div>
    <div class="splash-hud">
      <p class="splash-caption" data-chain-label={t(lang, 'splash.chain')}></p>
      <div class="splash-ctrls">
        <button class="btn small" type="button" data-trace>{t(lang, 'splash.trace')}</button>
        <button class="btn small" type="button" data-pause data-pause-label={t(lang, 'splash.pause')} data-play-label={t(lang, 'splash.play')} aria-pressed="false">{t(lang, 'splash.pause')}</button>
      </div>
    </div>
  </section>
  <script is:inline type="application/json" id="splash-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</Base>

<script>
  import '../../scripts/splash';
</script>

<style is:global>
  .home-splash .site-footer {
    margin-top: 0;
  }

  .splash {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: max(calc(100svh - var(--header-h)), 620px);
    overflow: hidden;
    background: var(--bg);
  }

  .splash-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: manipulation;
  }

  .splash-copy {
    position: relative;
    z-index: 1;
    width: min(44vw, 560px);
    margin-left: max(1.5rem, calc((100vw - 1240px) / 2));
    padding-top: clamp(2rem, 9vh, 6rem);
    pointer-events: none;
  }

  .splash-copy a,
  .splash-copy button {
    pointer-events: auto;
  }

  .splash h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    margin: 0.4rem 0 1rem;
    line-height: 1;
  }

  .splash h1 .x {
    color: var(--accent);
    font-weight: 400;
  }

  .splash .lead {
    max-width: 34rem;
  }

  .splash .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0 1.6rem;
  }

  .splash .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0 0 1rem;
  }

  .splash .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .splash .stats dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .splash .stats dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .splash-hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .splash-hud {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    padding: 0.8rem max(1.5rem, calc((100vw - 1240px) / 2)) 1rem;
  }

  .splash-caption {
    flex: 1 1 280px;
    margin: 0;
    padding: 0.4rem 0.75rem;
    min-height: 2.2rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.86rem;
  }

  .splash-caption b {
    color: var(--comp);
  }

  .splash-caption .math {
    color: var(--accent);
  }

  .splash-ctrls {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 899px) {
    .splash {
      min-height: 0;
    }

    .splash-copy {
      order: 1;
      width: auto;
      margin: 0;
      padding: 2rem 1.25rem 0.5rem;
    }

    .splash-canvas {
      order: 2;
      position: relative;
      height: clamp(360px, 62svh, 520px);
    }

    .splash-hud {
      order: 3;
      position: relative;
      padding: 0.6rem 1.25rem 1rem;
    }
  }
</style>
