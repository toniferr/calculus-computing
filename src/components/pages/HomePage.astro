---
import Base from '../../layouts/Base.astro';
import { getGraph } from '../../lib/graph';
import { href, t, type Lang, type UIKey } from '../../lib/i18n';

// The home page is only the title screen: one curve and four ideas of calculus at work on it, one after another
// (scripts/splash.ts). The guided overview that used to live here is on /overview/.
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const g = await getGraph();

const stats = [
  { n: g.topics.length, key: 'home.stats.topics' as const },
  { n: g.edges.length, key: 'home.stats.links' as const },
  { n: g.areas.length, key: 'home.stats.areas' as const },
];

// Each act names its topic and where it is used; the links are real connections from the content (applications of
// the mathematical topic, or the computing topics built on it), so g.topic() fails the build if one disappears.
const acts: { chip: UIKey; text: UIKey; topic: string; uses: string[] }[] = [
  { chip: 'splash.act.derivative', text: 'splash.text.derivative', topic: 'derivative', uses: ['automatic-differentiation', 'physics-engine'] },
  { chip: 'splash.act.integral', text: 'splash.text.integral', topic: 'definite-integral', uses: ['rendering-equation', 'monte-carlo'] },
  { chip: 'splash.act.taylor', text: 'splash.text.taylor', topic: 'taylor-polynomial', uses: ['floating-point', 'physics-engine'] },
  { chip: 'splash.act.descent', text: 'splash.text.descent', topic: 'gradient-descent', uses: ['neural-networks', 'backpropagation'] },
];
const link = (id: string) => ({ url: href(lang, `topic/${id}/`), title: g.topic(id).title[lang] });

// Words the canvas writes, and the language for its numbers.
const words = {
  lang,
  degree: t(lang, 'splash.degree'),
  step: t(lang, 'splash.step'),
  local: t(lang, 'splash.local'),
  global: t(lang, 'splash.global'),
};
---

<Base lang={lang} bodyClass="home-splash">
  <section class="splash" aria-labelledby="splash-title">
    <canvas class="splash-canvas" role="img" aria-label={t(lang, 'splash.label')}></canvas>
    <div class="splash-copy">
      <p class="eyebrow">{t(lang, 'splash.eyebrow')}</p>
      <h1 id="splash-title">Calculus <span class="x">×</span> Computing</h1>
      <p class="lead">{t(lang, 'splash.lead')}</p>
      <div class="hero-cta">
        <a class="btn primary" href={href(lang, 'overview/')}>{t(lang, 'splash.start')} →</a>
        <a class="btn" href={href(lang, 'map/')}>⌖ {t(lang, 'home.explore')}</a>
        <a class="btn" href={href(lang, 'topics/')}>{t(lang, 'home.syllabus')}</a>
      </div>
      <dl class="stats">
        {
          stats.map((s) => (
            <div>
              <dt>{t(lang, s.key)}</dt>
              <dd>{s.n}</dd>
            </div>
          ))
        }
      </dl>
      <p class="splash-hint">{t(lang, 'splash.hint')}</p>
    </div>
    <div class="splash-hud">
      <ol class="splash-acts">
        {
          acts.map((a, i) => (
            <li>
              <button type="button" data-act={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="n">{i + 1}</span>
                {t(lang, a.chip)}
              </button>
            </li>
          ))
        }
      </ol>
      <div class="splash-line">
        {
          acts.map((a, i) => {
            const topic = link(a.topic);
            return (
              <p class="splash-caption" data-caption={i} hidden={i !== 0}>
                <a class="topic" href={topic.url}>{topic.title}</a>: {t(lang, a.text)}{' '}
                <span class="uses">
                  {t(lang, 'splash.uses')}:{' '}
                  {a.uses.map(link).map((u, k) => (
                    <>
                      {k > 0 && ' · '}
                      <a href={u.url}>{u.title}</a>
                    </>
                  ))}
                </span>
              </p>
            );
          })
        }
        <div class="splash-ctrls">
          <button class="btn small" type="button" data-next>{t(lang, 'splash.next')} →</button>
          <button class="btn small" type="button" data-pause data-pause-label={t(lang, 'splash.pause')} data-play-label={t(lang, 'splash.play')} aria-pressed="false">{t(lang, 'splash.pause')}</button>
        </div>
      </div>
    </div>
  </section>
  <script is:inline type="application/json" id="splash-data" set:html={JSON.stringify(words).replace(/</g, '\\u003c')} />
</Base>

<script>
  import '../../scripts/splash';
</script>

<style is:global>
  .home-splash .site-footer {
    margin-top: 0;
  }

  .splash {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: max(calc(100svh - var(--header-h)), 640px);
    overflow: hidden;
    background: var(--bg);
  }

  .splash-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: manipulation;
    cursor: crosshair;
  }

  .splash-copy {
    position: relative;
    z-index: 1;
    width: min(40vw, 540px);
    margin-left: max(1.5rem, calc((100vw - 1240px) / 2));
    padding-top: clamp(2rem, 9vh, 6rem);
    pointer-events: none;
  }

  .splash-copy a,
  .splash-copy button {
    pointer-events: auto;
  }

  .splash h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    margin: 0.4rem 0 1rem;
    line-height: 1;
  }

  .splash h1 .x {
    color: var(--accent);
    font-weight: 400;
  }

  .splash .lead {
    max-width: 34rem;
  }

  .splash .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0 1.6rem;
  }

  .splash .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0 0 1rem;
  }

  .splash .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .splash .stats dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .splash .stats dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .splash-hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .splash-hud {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.6rem;
    padding: 0.8rem max(1.5rem, calc((100vw - 1240px) / 2)) 1rem;
  }

  .splash-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .splash-acts button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    overflow: hidden;
    padding: 0.32rem 0.8rem 0.32rem 0.4rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(6px);
    color: var(--muted);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }

  .splash-acts button:hover {
    color: var(--fg);
  }

  .splash-acts .n {
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .splash-acts button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--fg);
  }

  .splash-acts button[aria-pressed='true'] .n {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* How far the act has played, as a thin bar along the bottom of its chip. */
  .splash-acts button[aria-pressed='true']::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: calc(var(--p, 0) * 100%);
    background: var(--accent);
  }

  .splash-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .splash-caption {
    flex: 1 1 280px;
    margin: 0;
    padding: 0.45rem 0.75rem;
    min-height: 2.2rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.88rem;
  }

  .splash-caption[hidden] {
    display: none;
  }

  .splash-caption .topic {
    font-weight: 700;
  }

  .splash-caption .uses {
    color: var(--muted);
  }

  .splash-caption .uses a {
    color: var(--comp);
  }

  .splash-ctrls {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 899px) {
    .splash {
      min-height: 0;
    }

    .splash-copy {
      order: 1;
      width: auto;
      margin: 0;
      padding: 2rem 1.25rem 0.5rem;
    }

    .splash-canvas {
      order: 2;
      position: relative;
      height: clamp(340px, 56svh, 480px);
    }

    .splash-hud {
      order: 3;
      position: relative;
      padding: 0.6rem 1.25rem 1rem;
    }
  }
</style>
