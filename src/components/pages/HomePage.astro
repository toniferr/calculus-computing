---
import Base from '../../layouts/Base.astro';
import { getGraph } from '../../lib/graph';
import { href, t, type Lang } from '../../lib/i18n';
import { mdInline, unlink } from '../../lib/md';
import ConceptMap from '../ConceptMap.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const g = await getGraph();
const L = (en: string, es: string) => (lang === 'es' ? es : en);

const stats = [
  { n: g.topics.length, key: 'home.stats.topics' as const },
  { n: g.edges.length, key: 'home.stats.links' as const },
  { n: g.areas.length, key: 'home.stats.areas' as const },
  { n: g.demoTopics.length, key: 'home.stats.demos' as const },
];

const thesis: { text: string; to?: string }[] = [
  { text: L('Calculus', 'El cálculo') },
  { text: L('describes change', 'describe el cambio'), to: 'topic/derivative/' },
  { text: L('and accumulation', 'y la acumulación'), to: 'topic/definite-integral/' },
  { text: L('lets us model systems', 'permite modelar sistemas'), to: 'topic/ode/' },
  { text: L('lets us optimize', 'permite optimizar'), to: 'topic/gradient-descent/' },
  { text: L('lets us approximate', 'permite aproximar'), to: 'topic/taylor-series/' },
  { text: L('lets us simulate', 'permite simular'), to: 'topic/physics-engine/' },
];
const ends = [
  { id: 'ml', label: L('AI', 'IA') },
  { id: 'graphics', label: L('graphics', 'gráficos') },
  { id: 'simulation', label: L('physics', 'física') },
  { id: 'robotics', label: L('robotics', 'robótica') },
  { id: 'computing', label: L('scientific computing', 'computación científica') },
];

// The chain of section 39 of the brief; the topic page shows the full computed path.
const backpropPath = ['functions', 'derivative', 'chain-rule', 'multivariable-functions', 'partial-derivatives', 'gradient',
  'multivariable-chain-rule', 'loss-function', 'gradient-descent', 'neural-networks'].map((id) => g.topic(id));
const backpropAll = g.upstream('backpropagation').length;
const derivativeUses = g.reachByArea('derivative', 3);
const mathAreas = g.areas.filter((a) => a.kind === 'math');
const compAreas = g.areas.filter((a) => a.kind === 'computing');
---

<Base lang={lang}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <p class="eyebrow">{L('An interactive knowledge map', 'Un mapa de conocimiento interactivo')}</p>
        <h1>Calculus <span class="x">×</span> Computing</h1>
        <p class="lead">
          {
            L(
              'All of university calculus — from limits to vector calculus, differential equations and Fourier — and where every idea shows up in AI, graphics, simulation, robotics and scientific computing.',
              'Todo el cálculo universitario —de los límites al cálculo vectorial, las ecuaciones diferenciales y Fourier— y dónde aparece cada idea en IA, gráficos, simulación, robótica y computación científica.',
            )
          }
        </p>
        <div class="hero-cta">
          <a class="btn primary" href={href(lang, 'map/')}>⌖ {t(lang, 'home.explore')}</a>
          <a class="btn" href={href(lang, 'topics/')}>{t(lang, 'home.syllabus')}</a>
          <button class="btn" type="button" data-search-open>
            {t(lang, 'nav.search')} <kbd>/</kbd>
          </button>
        </div>
        <dl class="stats">
          {
            stats.map((s) => (
              <div>
                <dt>{t(lang, s.key)}</dt>
                <dd>{s.n}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>{t(lang, 'home.bigmap')}</h2></div>
    <ConceptMap lang={lang} />
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>{t(lang, 'home.thesis')}</h2></div>
    <ol class="thesis-flow">
      {
        thesis.map((s) => (
          <li>{s.to ? <a href={href(lang, s.to)}>{s.text}</a> : <strong>{s.text}</strong>}</li>
        ))
      }
      <li class="thesis-end">
        {L('a core piece of', 'una pieza fundamental de')}{' '}
        {
          ends.map((e, i) => (
            <>
              {i > 0 && (i === ends.length - 1 ? L(' and ', ' y ') : ', ')}
              <a href={href(lang, `area/${e.id}/`)}>{e.label}</a>
            </>
          ))
        }
      </li>
    </ol>
  </section>

  <section class="wrap section">
    <div class="two-questions">
      <article class="card question">
        <p class="eyebrow">{L('Upstream', 'Hacia atrás')}</p>
        <h2>{L('Where does backpropagation come from?', '¿De dónde sale la retropropagación?')}</h2>
        <ol class="qpath">
          {
            [...backpropPath, g.topic('backpropagation')].map((tp) => (
              <li>
                <a href={href(lang, `topic/${tp.id}/`)} class:list={[`lv-${tp.level}`]}>
                  {tp.title[lang]}
                </a>
              </li>
            ))
          }
        </ol>
        <a class="btn small" href={href(lang, 'topic/backpropagation/')}>{t(lang, 'sec.fullPath')} ({backpropAll}) →</a>
      </article>
      <article class="card question">
        <p class="eyebrow">{L('Downstream', 'Hacia delante')}</p>
        <h2>{L('Where is the derivative used?', '¿Dónde se utiliza la derivada?')}</h2>
        <ul class="quses">
          {
            derivativeUses.slice(0, 7).map(({ area, items }) => (
              <li>
                <a class="computing" href={href(lang, `area/${area.id}/`)}>
                  {area.glyph} {area.title[lang]}
                </a>
                <span>
                  {items.map((r, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a href={href(lang, `topic/${r.topic.id}/`)}>{r.topic.title[lang]}</a>
                    </>
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
        <a class="btn small" href={`${href(lang, 'topic/derivative/')}#used-by`}>{t(lang, 'sec.usedBy')} →</a>
      </article>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>{t(lang, 'home.routes')}</h2>
      <a href={href(lang, 'routes/')}>{t(lang, 'routes.title')} →</a>
    </div>
    <div class="grid">
      {
        g.routes.map((r) => (
          <a class="card" href={href(lang, `routes/${r.id}/`)}>
            <span class="glyph">{r.glyph}</span>
            <h3>{r.title[lang]}</h3>
            <p>{r.summary[lang]}</p>
            <span class="meta">
              {r.steps.length} {t(lang, 'routes.steps')}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>{t(lang, 'home.demos')}</h2>
      <a href={href(lang, 'lab/')}>{t(lang, 'lab.title')} →</a>
    </div>
    <div class="grid">
      {
        g.demoTopics.map((tp) => (
          <a class="card" href={`${href(lang, 'lab/')}#lab-${tp.id}`}>
            <span class="demo-glyph" aria-hidden="true">◐</span>
            <h3>{tp.title[lang]}</h3>
            <p set:html={unlink(mdInline(tp.summary[lang], lang, `${tp.id}.summary`))} />
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>{t(lang, 'home.areas')}</h2></div>
    <h3 class="block-title">{t(lang, 'syl.mathBlock')}</h3>
    <div class="area-chips">
      {
        mathAreas.map((a) => (
          <a class="area-chip math" href={href(lang, `area/${a.id}/`)}>
            <span class="glyph">{a.glyph}</span>
            {a.title[lang]}
            <span class="count">{a.topics.length}</span>
          </a>
        ))
      }
    </div>
    <h3 class="block-title">{t(lang, 'syl.compBlock')}</h3>
    <div class="area-chips">
      {
        compAreas.map((a) => (
          <a class="area-chip computing" href={href(lang, `area/${a.id}/`)}>
            <span class="glyph computing">{a.glyph}</span>
            {a.title[lang]}
            <span class="count">{a.topics.length}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style is:global>
  .hero {
    padding: clamp(3rem, 8vw, 6rem) 0 1rem;
    background:
      radial-gradient(ellipse at 70% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%),
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 32px 32px;
    border-bottom: 1px solid var(--line);
  }

  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    margin: 0.4rem 0 1rem;
  }

  .hero h1 .x {
    color: var(--accent);
    font-weight: 400;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0 2rem;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0 0 1.5rem;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .stats dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .thesis-flow {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0;
    font-size: 1.05rem;
  }

  .thesis-flow li {
    display: inline-flex;
    align-items: center;
  }

  .thesis-flow li + li::before {
    content: '→';
    margin: 0 0.6rem;
    color: var(--faint);
  }

  .thesis-flow a {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--fg);
  }

  .thesis-end {
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .thesis-end a {
    border-color: color-mix(in srgb, var(--comp) 45%, var(--line)) !important;
    color: var(--comp) !important;
  }

  .two-questions {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }

  .question h2 {
    font-size: 1.3rem;
    margin: 0.2rem 0 0.8rem;
  }

  .question .btn {
    align-self: flex-start;
    margin-top: 0.8rem;
  }

  .qpath {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    font-size: 0.9rem;
  }

  .qpath li + li::before {
    content: '→';
    margin: 0 0.4rem;
    color: var(--faint);
  }

  .qpath a {
    color: var(--fg);
    border-bottom: 1px solid var(--lv);
  }

  .qpath li:last-child a {
    font-weight: 650;
    color: var(--lv);
  }

  .quses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: 0.9rem;
  }

  .quses li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.6rem;
  }

  .quses a.computing {
    color: var(--comp);
    font-weight: 550;
  }

  .quses span a {
    color: var(--fg-2);
  }

  .demo-glyph {
    font-size: 1.4rem;
    color: var(--accent);
  }

  .area-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }

  .area-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--fg);
    font-size: 0.92rem;
  }

  .area-chip:hover {
    text-decoration: none;
    border-color: var(--line-2);
  }

  .area-chip .glyph {
    font-size: 1rem;
    min-width: 1.6rem;
    text-align: center;
  }

  .area-chip .count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .quses li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
