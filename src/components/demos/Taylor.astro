---
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (en: string, es: string) => (lang === 'es' ? es : en);
---

<figure class="demo" data-demo="taylor" data-s-radius={L('radius of convergence', 'radio de convergencia')} data-s-maxerr={L('max error on [a−1, a+1]', 'error máximo en [a−1, a+1]')} data-s-order={L('order', 'orden')}>
  <div class="demo-controls">
    <label
      >f(x) =
      <select data-fn>
        <option value="sin">sin x</option>
        <option value="cos">cos x</option>
        <option value="exp">eˣ</option>
        <option value="log1p">ln(1 + x)</option>
        <option value="geom">1/(1 − x)</option>
        <option value="runge">1/(1 + x²)</option>
      </select>
    </label>
    <label>{L('order', 'orden')} n <input type="range" data-n min="0" max="20" value="3" /><output data-n-out></output></label>
    <label>{L('centre', 'centro')} a <input type="range" data-a min="0" max="100" value="50" /><output data-a-out></output></label>
  </div>
  <canvas class="demo-canvas" data-aspect="0.55"></canvas>
  <div class="demo-readout" aria-live="polite"></div>
  <p class="demo-poly mono small" aria-live="polite"></p>
  <figcaption>
    <span class="demo-key key-math">f</span>&nbsp;
    <span class="demo-key key-accent">T<sub>n</sub></span>
    — {L('The shaded band is |x − a| < R. Outside it the polynomials eventually diverge however high the order — for 1/(1 + x²) because of the complex poles at ±i, invisible on the real line.', 'La banda sombreada es |x − a| < R. Fuera de ella los polinomios acaban divergiendo por alto que sea el orden; en 1/(1 + x²), por los polos complejos en ±i, invisibles en la recta real.')}
  </figcaption>
</figure>

<script>
  import { initTaylor } from '../../scripts/demos/taylor';
  document.querySelectorAll<HTMLElement>('[data-demo="taylor"]').forEach(initTaylor);
</script>

<style>
  .demo-poly {
    margin: 0.4rem 0 0;
    color: var(--fg-2);
    overflow-x: auto;
    white-space: nowrap;
  }
</style>
